	(text "When Link in NOT in use\na jumper can be placed on\nthe odd/even pin to ensure\nthe input is not noisy"
		(exclude_from_sim no)
		(at 375.666 29.972 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1385aed9-228f-49e4-9012-8d5ce981aab2")
	)
	(text "RESET active when\nCPLD is being Programmed"
		(exclude_from_sim no)
		(at 269.748 208.026 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1f1f69c5-34fa-4f5a-a9d5-32102dc3de3d")
	)
	(text "JP3 is here just\nin case GCLK3 doesn't\nwork with the PLD code"
		(exclude_from_sim no)
		(at 192.532 182.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "58681a53-d1e2-485f-b82f-38900db48f1f")
	)
	(text "For my PC104 stack Link3 \nis passed through\neach board, so it has\na driver"
		(exclude_from_sim no)
		(at 339.598 24.892 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5902a62f-40c7-4a10-89be-2c277174f28c")
	)
	(text "If doing 16 bit transfers\nRS0 and RS1 should go to \nAD1 and AD2 respectively"
		(exclude_from_sim no)
		(at 118.872 128.778 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5d7bbeea-8c5b-4ec2-9fa0-0f31eda5d258")
	)
	(text "This allows me to use \n16bit transfers or IRQ\nbased things.\nThe 16bit transfer is quicker\neven if the upper 8 bits are ignored\nRS0 and RS1 jumpers need changing!"
		(exclude_from_sim no)
		(at 94.742 266.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a64e60f2-bb81-47bd-b512-56e9e878ff05")
	)
	(text "1 - L1OUT\n2 - n/c\n3 - L1IN\n4 - 10K to 0V\n5 - L2OUT\n6 - RESET\n7 - L2IN\n8 - 10K to 0V\n9 - L3OUT\n10- ANALYSE\n11- L3IN\n12- 10K to 0V\n13- 5MHZ OUT\n14- nERROR\n15- GND\n16- GND"
		(exclude_from_sim no)
		(at 345.186 59.944 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b9c36eec-52b8-44c5-bc49-c72ce3b4792b")
	)
