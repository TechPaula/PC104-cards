Name     C011Glue;
PartNo   ;
Date     July2025;
Revision ;
Designer PaulaMaddox;
Company  ;
Assembly ;
Location ;
Device	f1502ispplcc44;

/*****************************************************/
/* decode an address and set nCS for device          */
/* Also set Write and Read lines only when selected  */
/*****************************************************/

/* Inputs */
pin 4 = A0;
pin 5 = A1;
pin 6 = A4;
pin 8 = A5;
pin 9 = A6;
pin 12 = A7;
pin 14 = A8;
pin 16 = A9;

pin 27 = !NotAEN;
pin 17 = !NotIOW;
pin 18 = !NotIOR;
pin 28 = ADDR_SEL;

pin 40 = !NotPCError;
pin 41 = PCLK;


/* Outputs */
pin 19 = D0;
pin 39 = !NotPCAnalyse;
pin 37 = NotPCReset;
pin 36 = C011Reset;
pin 34 = !NotWrite;
pin 33 = !NotCS;
pin 11 = !NotSys;			/* No connect pin */
pin 24 = !NotLadp;			/* No connect pin */
pin 25 = !NotStatWr;		/* No connect pin */

pin 20 = ReadSys;			/* Temporary test pin */

PINNODE = WriteSys;

/* Logic Equations */

FIELD IBMAddr = [A9..A4];
FIELD Register = [A1..A0];
FIELD Outputs = [NotPCReset, NotPCAnalyse, NotStatWr];

Outputs.ar = 'b'0;
Outputs.sp = 'b'0;
Outputs.ck = PCLK;		/* CPLD needs this to know which clocks to use */

	/* Address decode */
NotLadp = NotAEN & IBMAddr:[150];
NotSys  = NotAEN & IBMAddr:[160];
	
	/* Abbreviations */
ReadSys 		= NotIOR & NotSys;
WriteSys		= NotIOW & NotSys;
ReadLink		= NotIOR & NotLadp;
WriteLink 	= NotIOW & NotLadp;
WriteReset	= WriteSys & Register:[0];
WriteAnalyse	= WriteSys & Register:[1];

	/* C011, 245 Control */
NotStatWr.d 	= NotIOW;
NotCS 		= WriteLink & NotStatWr # ReadLink;
NotWrite		= WriteLink # NotStatWr & NotLadp;
C011Reset		= NotPCReset; 

	/* Reset, Analyse, Error */
NotPCReset.d  		= D0 & WriteReset # NotPCReset & !WriteReset;
NotPCAnalyse.d  	= D0 & WriteAnalyse # NotPCAnalyse & !WriteAnalyse;
D0				= NotPCError;
D0.oe 			= ReadSys;
